{
  "type": "{% if ChartRenderer == 'Type:LineChart' %}line{% elif ChartRenderer == 'Type:BarChart' %}bar{% elif ChartRenderer == 'Type:ScatterPlot' %}scatter{% elif ChartRenderer == 'Type:BoxPlot' %}boxplot{% else %}bar{% endif %}",
  "data": {
    "labels": {{ labels | tojson }},
    "datasets": {{ datasets | tojson }}
  },
  "options": {
    "responsive": true,
    "maintainAspectRatio": false,
    "indexAxis": "{% if Horizontal %}y{% else %}x{% endif %}",
    "plugins": {
      "legend": {
        "display": true,
        "position": "top"
      },
      "title": {
        "display": true,
        "text": "{{ chartTitle }}",
        "font": {
          "size": 16
        }
      }
    },
    "scales": {
      "y": {
        "beginAtZero": {% if AxisConfigurator == 'StartAtZero:False' %}false{% else %}true{% endif %},
        "stacked": {% if SeriesConfigurator == 'Stacking:Enabled' %}true{% else %}false{% endif %},
        "grid": {
          "display": {% if StyleConfigurator == 'ShowGrid:True' %}true{% else %}false{% endif %}
        }
      },
      "x": {
        {% if ChartRenderer == 'Type:ScatterPlot' %} "type": "category", {% endif %}
        "stacked": {% if SeriesConfigurator == 'Stacking:Enabled' %}true{% else %}false{% endif %},
        "grid": {
          "display": {% if StyleConfigurator == 'ShowGrid:True' %}true{% else %}false{% endif %}
        }
      }
    }
  }
}